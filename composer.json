{
    "require": {
        "php": ">=8.3",
        "erseco/autofirma-intermediate-server": "dev-main",
        "tinybutstrong/tinybutstrong": "^3.15.3",
        "tinybutstrong/opentbs": "^1.12.3",
        "setasign/fpdf": "^1.9"
    },
    "require-dev": {
        "brianium/paratest": "^6.11",
        "carthage-software/mago": "^1.13",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^9.6.35",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-cli/dist-archive-command": "^3.1",
        "wp-cli/i18n-command": "^2.7.0",
        "wp-coding-standards/wpcs": "^3.4",
        "wp-phpunit/wp-phpunit": "^7.0.2",
        "yoast/phpunit-polyfills": "^1.1.5",
        "yoast/wp-test-utils": "^1.2.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "scripts": {
        "copy-runtime-dependencies": [
            "rm -rf admin/vendor/tinybutstrong",
            "cp -r vendor/tinybutstrong admin/vendor/",
            "rm -rf admin/vendor/setasign",
            "mkdir -p admin/vendor/setasign/fpdf",
            "cp vendor/setasign/fpdf/fpdf.php admin/vendor/setasign/fpdf/",
            "cp -r vendor/setasign/fpdf/font admin/vendor/setasign/fpdf/",
            "cp vendor/setasign/fpdf/license.txt admin/vendor/setasign/fpdf/",
            "rm -rf includes/vendor/autofirma-intermediate-server",
            "mkdir -p includes/vendor/autofirma-intermediate-server",
            "cp -r vendor/erseco/autofirma-intermediate-server/src includes/vendor/autofirma-intermediate-server/"
        ],
        "post-install-cmd": [
            "@copy-runtime-dependencies"
        ],
        "post-update-cmd": [
            "@copy-runtime-dependencies"
        ],
        "phpunit": "vendor/bin/phpunit",
        "test": "@phpunit",
        "test:coverage": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --colors=always --coverage-text --coverage-html artifacts/coverage/html --coverage-clover artifacts/coverage/clover.xml --coverage-filter=admin --coverage-filter=includes --coverage-filter=public --coverage-filter=documentate.php --coverage-filter=uninstall.php",
        "test:e2e": "wp-scripts test-playwright",
        "test:e2e:ui": "wp-scripts test-playwright --ui",
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=.phpcs.xml.dist",
        "mago:lint": "@php ./vendor/bin/mago lint",
        "mago:format": "@php ./vendor/bin/mago format",
        "make-pot": "wp i18n make-pot . languages/documentate.pot --domain=documentate --exclude=vendor,assets,node_modules,tests,wp,wp-content --include=**/*.php",
        "pot-remove-refs": "sed -i.bak '/^#: /d' languages/documentate.pot && rm languages/documentate.pot.bak",
        "update-po": "wp i18n update-po languages/documentate.pot languages/documentate-es_ES.po",
        "make-mo": "wp i18n make-mo languages/ languages/",
        "make-php": "wp i18n make-php languages/ languages/",
        "pot-remove-ctime": "sed -i.bak '/POT-Creation-Date:/d' languages/documentate.pot && rm languages/documentate.pot.bak",
        "untranslated": "msgattrib --untranslated languages/documentate-es_ES.po && [ $(msgattrib --untranslated languages/documentate-es_ES.po | wc -l) -eq 0 ]",
        "check-untranslated": "composer make-pot && composer pot-remove-ctime && composer pot-remove-refs && composer update-po && composer untranslated && composer make-mo && composer make-php"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "autoload": {
        "psr-4": {
            "Documentate\\": "includes/",
            "Documentate\\Admin\\": "admin/",
            "Documentate\\Public\\": "public/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Documentate\\Tests\\": "tests/"
        }
    },
    "type": "project"
}
