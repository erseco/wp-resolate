{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "latest",
    "wp": "latest"
  },
  "siteOptions": {
    "blogname": "WordPress Playground Documentate Demo"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_ENVIRONMENT_TYPE": "development",
        "WORDPRESS_PLAYGROUND": true
      }
    },
    {
      "step": "setSiteLanguage",
      "language": "es_ES"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "user-switching"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "wp-mail-logging"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/ateeducacion/wp-documentate/archive/refs/heads/main.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once('/wordpress/wp-load.php'); $src = glob(WP_PLUGIN_DIR . '/*/scripts/mu-plugins/documentate-dev-tools.php'); if ($src) { if (!is_dir(WPMU_PLUGIN_DIR)) { mkdir(WPMU_PLUGIN_DIR, 0755, true); } copy($src[0], WPMU_PLUGIN_DIR . '/documentate-dev-tools.php'); } ?>"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once('/wordpress/wp-load.php'); update_option('documentate_settings', array('conversion_engine' => 'collabora', 'collabora_base_url' => 'https://documentate-collabora-proxy.erseco.workers.dev')); ?>"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once('/wordpress/wp-load.php'); if ( class_exists('Documentate_Demo_App') ) { Documentate_Demo_App::asegurar_entorno(); Documentate_Demo_App::seed(); } ?>"
    }
  ],
  "features": {
    "networking": true
  },
  "login": true,
  "landingPage": "/documentate/"
}
