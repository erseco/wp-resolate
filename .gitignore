# Exclude common development files and folders
node_modules/
/vendor/

*.log
*.sql
*.sql.gz
*.tar.gz
*.zip
wp-documentate*/
documentate*/
*.swp
*.swo
*.bak
*.bkp
*.back
*.tmp
*~
~$*
.~lock.*
.DS_Store
Thumbs.db
sftp-config.json

# Exclude specific editor/IDE files
/.idea/
.vscode/
.project
.settings/
*.sublime-workspace
*.sublime-project

# Exclude test-related files and directories
# /tests/
# /phpunit.xml
# /phpunit.xml.dist
.phpunit.result.cache
/behat.yml
.php-cs-fixer.cache

admin/vendor/tinybutstrong/tinybutstrong/examples/
admin/vendor/tinybutstrong/tinybutstrong/testunit/
admin/vendor/tinybutstrong/tinybutstrong/.gitattributes
admin/vendor/tinybutstrong/tinybutstrong/.gitignore

# LibreOffice WASM: dist/ and wasm/ are generated from
# @matbee/libreoffice-converter by `npm run copy:libreoffice-converter`, which
# runs on postinstall and again from `make package`. They are not committed, so
# the tree cannot drift from the pinned package version. `composer archive`
# packages the working tree and ignores .gitignore, so they still ship.
# The large binaries (soffice.wasm/soffice.data, ~235 MB) are CDN-served and
# never written here at all. README.md is hand-written and stays tracked.
admin/vendor/libreoffice-converter/dist/
admin/vendor/libreoffice-converter/wasm/

.env

wp/
wp-content/
wordpress-develop/
artifacts/

# Ignore Sass source maps
*.css.map

# Playwright output
test-results/
.omc/

# Capturas generadas por «make capturas» (se regeneran, no se versionan)
/capturas/
